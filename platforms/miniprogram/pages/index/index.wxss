/* index.wxss */
.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #f5f5f7 0%, #e3e3e5 100%);
}

.hero {
  padding: 80rpx 40rpx;
  text-align: center;
  min-height: 80vh;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-content {
  max-width: 800rpx;
}

.hero-title {
  font-size: 64rpx;
  font-weight: 600;
  color: #1d1d1f;
  margin-bottom: 32rpx;
  display: block;
}

.hero-subtitle {
  font-size: 32rpx;
  color: #555;
  margin-bottom: 64rpx;
  display: block;
  line-height: 1.5;
}

.cta-buttons {
  display: flex;
  gap: 24rpx;
  justify-content: center;
  flex-wrap: wrap;
}

.btn {
  padding: 24rpx 48rpx;
  border-radius: 40rpx;
  font-size: 32rpx;
  font-weight: 500;
  transition: all 0.3s ease;
}

.chinese-btn {
  background-color: #e63946;
  color: white;
}

.western-btn {
  background-color: #457b9d;
  color: white;
}

@media (max-width: 768rpx) {
  .hero {
    padding: 60rpx 20rpx;
  }
  
  .hero-title {
    font-size: 48rpx;
  }
  
  .hero-subtitle {
    font-size: 28rpx;
  }
  
  .cta-buttons {
    flex-direction: column;
    align-items: center;
  }
  
  .btn {
    width: 300rpx;
    text-align: center;
  }
}